# Dependencies are pinned to exact versions, without `^`.
save-exact=true

# Choose only versions that have been public for a week, like Dependabot's
# cooldown. A compromised release is likely to be caught and removed by then.
# This applies when a version is chosen; `npm ci` installs what is in the
# lockfile.
min-release-age=7

# Do not run dependency scripts at install time. npm only warns about scripts
# it has not been told to allow, so they are turned off. If scripts are
# enabled for one install, any unreviewed script fails the install instead of
# running.
ignore-scripts=true
strict-allow-scripts=true

# Every dependency comes from the npm registry over verified TLS. None comes
# from a mirror in someone's own configuration, or from a git repository, URL,
# tarball or directory named in package.json or the lockfile.
registry=https://registry.npmjs.org/
strict-ssl=true
allow-git=none
allow-remote=none
allow-file=none
allow-directory=none

# Fail the install on problems that npm only warns about by default: a peer
# dependency that is missing or outside the requested range, or a package
# that does not support the running Node.js version.
strict-peer-deps=true
engine-strict=true

# Each package can load only the dependencies it declares, not whatever else
# happens to be installed next to it.
install-strategy=linked
