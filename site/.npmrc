# Dependencies are pinned to exact versions, without `^`.
save-exact=true

# Only versions that have been public for a week, as with Dependabot's
# cooldown: a compromised release is likely to be caught and removed by then.
min-release-age=7

# No dependency runs a script at install time, and none comes from a git
# repository or a URL instead of the registry.
ignore-scripts=true
allow-git=none
allow-remote=none
