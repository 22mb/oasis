# Dependencies are pinned to exact versions, without `^`.
save-exact=true

# Only versions that have been public for a week, as with Dependabot's
# cooldown: a compromised release is likely to be caught and removed by then.
# This applies when a version is chosen; `npm ci` installs what the lockfile says.
min-release-age=7

# No dependency runs a script at install time. npm only warns about scripts it
# has not been told to allow, so they are turned off; should that be lifted
# for one install, an unreviewed script fails it instead of running.
ignore-scripts=true
strict-allow-scripts=true

# Every dependency comes from the npm registry, over verified TLS: not from a
# mirror in someone's own configuration, a git repository, a URL, a tarball or
# a directory, in package.json or in the lockfile.
registry=https://registry.npmjs.org/
strict-ssl=true
allow-git=none
allow-remote=none
allow-file=none
allow-directory=none

# What npm only warns about by default fails the install: a package whose peer
# dependency is missing or outside the range it asks for, and a package that
# does not support the running Node.js.
strict-peer-deps=true
engine-strict=true

# Each package can load only the dependencies it declares, not whatever else
# happens to be installed next to it.
install-strategy=linked
